<panel>
  <div background-color="rgba(0,0,0,0.9)" border-radius="20" padding="16" flex-direction="column" align-items="center" gap="8">
    <div font-size="18" font-weight="bold" color="#00ffff">SETTINGS</div>
    <div font-size="11" color="#aaaaaa">Color Scheme</div>
    <div flex-direction="row" gap="8" align-items="center">
      <div name="btn-color-prev" font-size="12" color="#ffffff" background-color="#333333" border-radius="8" padding="6" cursor="pointer">&lt;</div>
      <div name="color-name" font-size="14" color="#00ffff">Cyan</div>
      <div name="btn-color-next" font-size="12" color="#ffffff" background-color="#333333" border-radius="8" padding="6" cursor="pointer">&gt;</div>
    </div>
    <div font-size="11" color="#aaaaaa" margin-top="4">Car Style</div>
    <div flex-direction="row" gap="8" align-items="center">
      <div name="btn-car-prev" font-size="12" color="#ffffff" background-color="#333333" border-radius="8" padding="6" cursor="pointer">&lt;</div>
      <div name="car-name" font-size="14" color="#ff00ff">Default</div>
      <div name="btn-car-next" font-size="12" color="#ffffff" background-color="#333333" border-radius="8" padding="6" cursor="pointer">&gt;</div>
    </div>
    <div name="car-info" font-size="9" color="#888888">1/4 unlocked</div>
    <div name="btn-settings-back" font-size="12" color="#ffffff" background-color="#555555" border-radius="10" padding-top="6" padding-bottom="6" padding-left="16" padding-right="16" margin-top="8" cursor="pointer">Back</div>
  </div>
</panel>

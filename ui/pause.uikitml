<panel>
  <div background-color="rgba(0,0,0,0.9)" border-radius="20" padding="20" flex-direction="column" align-items="center" gap="10">
    <div font-size="22" font-weight="bold" color="#ffcc00">PAUSED</div>
    <div name="btn-resume" font-size="14" color="#000000" background-color="#00ffff" border-radius="10" padding-top="8" padding-bottom="8" padding-left="20" padding-right="20" cursor="pointer">Resume</div>
    <div name="btn-quit" font-size="12" color="#ffffff" background-color="#ff4444" border-radius="10" padding-top="6" padding-bottom="6" padding-left="16" padding-right="16" cursor="pointer">Quit</div>
  </div>
</panel>

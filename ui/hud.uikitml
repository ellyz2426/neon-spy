<panel>
  <div background-color="rgba(0,0,0,0.6)" border-radius="12" padding="8" flex-direction="column" align-items="center" gap="4">
    <div flex-direction="row" gap="16" align-items="center">
      <div name="score" font-size="14" font-weight="bold" color="#00ffff">Score: 0</div>
      <div name="wave" font-size="12" color="#ff00ff">Wave 1</div>
      <div name="lives" font-size="12" color="#ffcc00">Lives: ooo</div>
    </div>
    <div flex-direction="row" gap="12" align-items="center">
      <div name="combo" font-size="11" color="#ff4444"></div>
      <div name="distance" font-size="10" color="#aaaaaa">0m</div>
      <div name="weapon" font-size="10" color="#ff00ff">Weapon: Dual</div>
      <div name="mode-info" font-size="10" color="#ffaa00"></div>
    </div>
    <div name="powerup-status" font-size="9" color="#ffff00"></div>
    <div name="gadget-status" font-size="9" color="#00ccff"></div>
    <div name="nitro-status" font-size="8" color="#ff6600"></div>
    <div name="mission-text" font-size="9" font-weight="bold" color="#00ff88"></div>
    <div name="mission-progress" font-size="8" color="#88ffaa"></div>
  </div>
</panel>
